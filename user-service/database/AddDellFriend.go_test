package database

import (
	"context"
	"database/sql"
	"errors"
	"testing"

	"github.com/DATA-DOG/go-sqlmock"
)

func TestListAllUsers(t *testing.T) {
	db, mock, err := sqlmock.New()
	if err != nil {
		t.Fatalf("unexpected error creating mock: %s", err)
	}
	defer db.Close()

	repo := &UserRepository{db: db}

	t.Run("success", func(t *testing.T) {
		rows := sqlmock.NewRows([]string{"id", "username", "location", "friend_status"}).
			AddRow(1, "alice", "Moscow", "accepted").
			AddRow(2, "bob", "", "none")

		mock.ExpectQuery("SELECT").
			WithArgs(10, 10, 10, 10, 10, 20, 0).
			WillReturnRows(rows)

		users, err := repo.ListAllUsers(context.Background(), 10, 20, 0)
		if err != nil {
			t.Errorf("expected no error, got %v", err)
		}
		if len(users) != 2 {
			t.Errorf("expected 2 users, got %d", len(users))
		}
		if err := mock.ExpectationsWereMet(); err != nil {
			t.Errorf("unmet expectations: %s", err)
		}
	})

	t.Run("query error", func(t *testing.T) {
		mock.ExpectQuery("SELECT").
			WithArgs(10, 10, 10, 10, 10, 20, 0).
			WillReturnError(errors.New("db error"))

		_, err := repo.ListAllUsers(context.Background(), 10, 20, 0)
		if err == nil {
			t.Errorf("expected error, got nil")
		}
	})
}

